# Web server
HOST=127.0.0.1
PORT=22821
REQUEST_TIMEOUT_MS=20000

# Dashboard login
ADMIN_USER=admin
ADMIN_PASS=
SESSION_SECRET=

# Mobile / PersonalToolbox API (Bearer or X-API-Key)
# curl -H "Authorization: Bearer $APP_API_TOKEN" https://checkin.example.com/api/v1/summary
APP_API_TOKEN=
# CHECKIN_API_TOKEN is accepted as an alias of APP_API_TOKEN

# Provider defaults
DEFAULT_EMBYPULSE_BASE_URL=https://embypulse.example.com
DEFAULT_EMBYMB_BASE_URL=https://embymb.ichinosekotomi.com

# Optional Telegram report bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=false

# Daily check-in retry behavior
CHECKIN_MAX_ATTEMPTS=3
CHECKIN_RETRY_DELAY_MS=5000
CHECKIN_CONCURRENCY=4
TELEGRAM_ALERT_ON_FAILURE=true

# Optional custom data file paths
GLADOS_ACCOUNTS_FILE=
EMBYPULSE_ACCOUNTS_FILE=
EMBYMB_ACCOUNTS_FILE=

# Optional override used by shell/python helper scripts
CHECKIN_PROJECT_ROOT=

# VPSNAT 纳泰云
DEFAULT_VPSNAT_BASE_URL=https://www.vpsnat.com
# VPSNAT_ACCOUNTS_FILE=/root/glados-checkin-web/data/vpsnat_accounts.json

# Optional account file override for 这只猫用户中心
# ZZCAT_ACCOUNTS_FILE=/path/to/zzcat_accounts.json

# Optional defaults; alternatively configure apiId / apiHash per Telegram account
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# THXNK_ACCOUNTS_FILE=/path/to/thxnk_accounts.json

# WorkBuddy (Python 3 + vendored upstream core; plaintext login credentials only)
WORKBUDDY_PYTHON=/usr/bin/python3
WORKBUDDY_BUDGET_SECONDS=420
# WORKBUDDY_ACCOUNTS_FILE=/root/glados-checkin-web/data/workbuddy_accounts.json

# Required credentials above must be non-default and at least 16 characters.
# Optional second token for rotation
APP_API_TOKEN_SECONDARY=
CHECKIN_DATA_DIR=
CHECKIN_STORE_RAW=0
ICON_FETCH_ENABLED=1
METRICS_ENABLED=0
HEALTH_MIN_FREE_BYTES=10485760
FAILURE_ALERT_DAYS=3
# Optional comma-separated glados,embypulse,embymb,vpsnat,thxnk,zzcat,workbuddy,telegram,emby_keepalive
RUNNER_PROVIDERS=
RUNNER_TASK_TIMEOUT_MS=3600000
# Private backup destination, outside data/ (contains account credentials)
CHECKIN_BACKUP_DIR=
